    { "id": "extras", "type": "multi", "text": "Include extras", "options": ["Docking station", "Second monitor", "Headset"], "optional": true },
    { "id": "quantity", "type": "number", "text": "How many units?" },
    { "id": "deliver_by", "type": "date", "text": "Deliver by" },
    { "id": "note", "type": "text", "text": "Note for procurement", "optional": true },
    { "id": "voice_note", "type": "voice", "text": "Voice note", "optional": true }
