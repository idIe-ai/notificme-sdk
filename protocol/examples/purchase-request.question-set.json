  "level": 1,
  "offline": "allowed",
  "timeout": "2d",
  "on_timeout": { "approve": false },
  "card": {
    "title": "Purchase request #4821",
    "blocks": [
      { "type": "metric", "label": "Estimated total", "value": 86400, "unit": "BRL" },
