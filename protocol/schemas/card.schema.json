{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notific.me/schemas/v0/card.schema.json",
  "title": "notific.me Card",
  "description": "Declarative card rendered with native components. Decisions (options, input) are always rendered by the app.",
  "type": "object",
  "required": ["blocks"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "0" },
    "title": { "type": "string", "maxLength": 120 },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "icon": { "type": "string", "description": "Icon URL or name." }
      }
    },
    "blocks": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "$ref": "#/$defs/block" } }
  },
  "$defs": {
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/text" },
        { "$ref": "#/$defs/metric" },
        { "$ref": "#/$defs/chart" },
        { "$ref": "#/$defs/table" },
        { "$ref": "#/$defs/list" },
        { "$ref": "#/$defs/image" },
        { "$ref": "#/$defs/progress" },
        { "$ref": "#/$defs/buttons" },
        { "$ref": "#/$defs/options" },
        { "$ref": "#/$defs/input" }
      ]
    },
    "text": {
      "type": "object", "required": ["type", "text"], "additionalProperties": false,
      "properties": { "type": { "const": "text" }, "text": { "type": "string", "maxLength": 4000 } }
    },
    "metric": {
      "type": "object", "required": ["type", "label", "value"], "additionalProperties": false,
      "properties": {
        "type": { "const": "metric" },
        "label": { "type": "string" },
        "value": { "type": ["number", "string"] },
        "unit": { "type": "string" },
        "delta": { "type": "string", "examples": ["+18%"] }
      }
    },
    "chart": {
      "type": "object", "required": ["type", "kind", "series"], "additionalProperties": false,
      "properties": {
        "type": { "const": "chart" },
        "kind": { "enum": ["line", "bar"] },
        "x": { "type": "array", "items": { "type": "string" } },
        "series": {
          "type": "array", "minItems": 1, "maxItems": 6,
          "items": {
            "type": "object", "required": ["name", "values"], "additionalProperties": false,
            "properties": { "name": { "type": "string" }, "values": { "type": "array", "items": { "type": "number" } } }
          }
        }
      }
    },
    "table": {
      "type": "object", "required": ["type", "columns", "rows"], "additionalProperties": false,
      "properties": {
        "type": { "const": "table" },
        "columns": { "type": "array", "items": { "type": "string" } },
        "rows": { "type": "array", "maxItems": 200, "items": { "type": "array", "items": { "type": ["string", "number", "null"] } } }
      }
    },
    "list": {
      "type": "object", "required": ["type", "items"], "additionalProperties": false,
      "properties": {
        "type": { "const": "list" },
        "items": {
          "type": "array",
          "items": {
            "type": "object", "required": ["text"], "additionalProperties": false,
            "properties": { "text": { "type": "string" }, "icon": { "type": "string" } }
          }
        }
      }
    },
    "image": {
      "type": "object", "required": ["type", "src"], "additionalProperties": false,
      "properties": { "type": { "const": "image" }, "src": { "type": "string" }, "alt": { "type": "string" } }
    },
    "progress": {
      "type": "object", "required": ["type"], "additionalProperties": false,
      "properties": {
        "type": { "const": "progress" },
        "value": { "type": "number", "minimum": 0, "maximum": 1 },
        "steps": { "type": "array", "items": { "type": "string" } },
        "current": { "type": "integer", "minimum": 0 }
      }
    },
    "buttons": {
      "type": "object", "required": ["type", "buttons"], "additionalProperties": false,
      "properties": {
        "type": { "const": "buttons" },
        "buttons": {
          "type": "array", "maxItems": 4,
          "items": {
            "type": "object", "required": ["label"], "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "url": { "type": "string", "format": "uri" },
              "action": { "type": "string", "description": "ID of an action registered by a plugin." }
            }
          }
        }
      }
    },
    "options": {
      "type": "object", "required": ["type", "question_id"], "additionalProperties": false,
      "description": "Renders a question of the question set (yesno, single or multi).",
      "properties": { "type": { "const": "options" }, "question_id": { "type": "string" } }
    },
    "input": {
      "type": "object", "required": ["type", "question_id"], "additionalProperties": false,
      "description": "Renders a question of the question set (text, voice, number or date).",
      "properties": { "type": { "const": "input" }, "question_id": { "type": "string" } }
    }
  }
}
